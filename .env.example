# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173


# config your database connection here, by crearte env file and copy into it

# MySQL (set DB_SYNCHRONIZE=true for dev only)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_DATABASE=jotform
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=604800

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must match Nest route: /auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:5173/auth/google/callback
GOOGLE_FAILURE_REDIRECT_URL=http://localhost:5173/auth/google/callback?error=1

